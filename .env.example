# Copy to .env and fill in what you use. Never commit .env.
# Compose requires a database password; use a generated URL-safe value.
POSTGRES_PASSWORD=

# --- AI provider (BYOK) --------------------------------------------------------------
# claude | gemini | ollama | opencode | none
# Use a Google AI Studio FREE-tier project; a paid project's key can incur charges.
SENTINEL_PROVIDER=gemini
SENTINEL_MODEL=gemini-3.8-flash
SENTINEL_CLAUDE_KEY=
SENTINEL_GEMINI_KEY=
# Opt in after starting the local Docker bridge (docs/FREE_AI_FALLBACK.md).
# Only Gemini HTTP 429 triggers free DeepSeek; GLM is not in this chain.
SENTINEL_FREE_FALLBACK=false
SENTINEL_FALLBACK_COOLDOWN=300
# The setup helper generates this separate local password; never reuse a vendor key.
SENTINEL_OPENCODE_TOKEN=
# CLI default; Compose override uses http://opencode-bridge:4097 instead.
SENTINEL_OPENCODE_URL=http://127.0.0.1:4097
# SENTINEL_OLLAMA_URL=http://localhost:11434
# SENTINEL_TIMEOUT=90

# --- Server --------------------------------------------------------------------------
# local = single user, loopback only; token = per-user API tokens (required in Docker)
SENTINEL_AUTH_MODE=token
# Public URL of the web UI, used for links in GitHub comments
# SENTINEL_PUBLIC_URL=https://sentinel.example.com
# Directories the API may review local repositories in (os.pathsep-separated)
# SENTINEL_LOCAL_ROOTS=/repos

# --- GitHub App (see docs/GITHUB_APP.md) -----------------------------------------------
# SENTINEL_GITHUB_APP_ID=
# SENTINEL_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# SENTINEL_GITHUB_WEBHOOK_SECRET=
# Or, for `sentinel review --pr` only, a personal access token:
# SENTINEL_GITHUB_TOKEN=

# --- Fix sandbox ---------------------------------------------------------------------
# SENTINEL_SANDBOX=docker
# SENTINEL_SANDBOX_IMAGE=sentinel-sandbox:latest
# Compose copies scratch data over stdin; container/daemon paths need not match.
# SENTINEL_SANDBOX_TRANSPORT=copy
# Linux: set DOCKER_GID to `stat -c %g /var/run/docker.sock`; Docker Desktop often uses 0.
# DOCKER_GID=0
# SENTINEL_DOCKER_SOCKET=/var/run/docker.sock
# Weaker, opt-in fallback when Docker is unavailable:
# SENTINEL_ALLOW_PROCESS_SANDBOX=1

# --- Logging -------------------------------------------------------------------------
# text | json
SENTINEL_LOG_FORMAT=json
